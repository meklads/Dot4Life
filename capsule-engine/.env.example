# d4l1-capsule-engine Environment Variables
# Copy this file to .env and fill in your values

# Server port (default: 3030)
PORT=3030

# Admin password (plain text — will be hashed at startup)
# Change this before going live!
ADMIN_PASSWORD=dotforlife2026

# Or provide a pre-hashed SHA-256 password (more secure):
# ADMIN_PASSWORD_HASH=<sha256 hash>

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost,https://www.dotforlife.com,https://dotforlife.com

# Session expiry in hours (default: 8)
SESSION_HOURS=8
