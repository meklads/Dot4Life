# d4l1-capsule-engine Environment Variables
# Copy this file to .env and fill in your values

# Server port (default: 3030)
PORT=3030

# ⚠️ Admin password — REQUIRED for admin access
# Choose a strong password (min 12 characters, mixed case + numbers)
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Or provide a pre-hashed SHA-256 password (more secure):
# ADMIN_PASSWORD_HASH=<sha256 hash>

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost,https://www.dotforlife.com

# PostgreSQL database URL
DATABASE_URL=postgresql://user:password@host:5432/d4l_capsules

# SSL certificate validation — set to 'true' in production
# DB_SSL_REJECT_UNAUTHORIZED=false

# Resend API key for contact form & pregnancy emails
# RESEND_API_KEY=re_xxxxx

# Email addresses for contact form
# CONTACT_EMAIL=dotforlife3@gmail.com
# RESEND_FROM=Dot4Life <journey@dotforlife.com>

# Site URL (used in emails)
# SITE_URL=https://www.dotforlife.com

# Session expiry in hours (default: 8)
SESSION_HOURS=8
