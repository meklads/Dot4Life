# OS / Editor junk
Thumbs.db
.DS_Store
*.db-shm
*.db-wal

# Local documents (not part of the site)
*.docx
*.xlsx
*.pdf
*.pptx

# Node
node_modules/
npm-debug.log

# Build / env
.env
dist/

# OG images cache
og/Thumbs.db
.deploy/

# Runtime logs (regenerated each autopilot run — never track, prevents merge conflicts)
outputs/logs/
*.log

# Python bytecode cache (regenerated — never track)
__pycache__/
*.pyc

# FUSE mount artifacts (orphaned open-file handles on sandbox mount — never track)
.fuse_hidden*

# Local-only archived logs (moved out of repo root by zcode cleanup)
_archive/
