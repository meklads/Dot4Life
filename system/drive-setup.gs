/**
 * 🚀 Google Drive Folder Setup — Dot4Life Team
 * 
 * كيف تستخدمه:
 * 1. افتح https://drive.google.com
 * 2. New → More → Google Apps Script
 * 3. امسح الكود الموجود والصق هذا الكود
 * 4. اكبس Run (تشغيل) — أول مرة يطلب أذونات، وافق
 * 5. كل الفولدرات بتظهر في Drive
 */

function createDot4LifeFolders() {
  const root = DriveApp.createFolder('📁 Dot4Life — فريق');
  
  // إنشاء المجلدات الرئيسية
  const folders = {
    '01-🎨-عمر-تصميم': ['صور-مقالات', 'تصميم-منشورات', 'ثمبنيلز-يوتيوب', 'شعارات-وهوية'],
    '02-✍️-موني-مقالات': ['جاهزة-للنشر', 'قيد-المراجعة', 'مسودات'],
    '03-🔍-ميدو-SEO': ['تقارير-أسبوعية', 'تحليلات-كلمات-مفتاحية'],
    '04-🎬-هيما-فيديو': ['خام', 'منشور'],
    '05-🤖-لينو-تقنية': ['سكربتات', 'ملاحظات-تقنية'],
    '06-📈-مازن-سوشيال-ميديا': ['منشورات-منشورة', 'جدول-المحتوى', 'تحليلات-الأداء'],
    '07-📊-اعلانات': ['تقارير-أداء', 'استراتيجيات'],
    '08-👻-جوست-قرارات': ['موافقات-وتوجيهات', 'ملاحظات'],
  };

  for (const [section, subs] of Object.entries(folders)) {
    const folder = root.createFolder(section);
    for (const sub of subs) {
      folder.createFolder(sub);
    }
    console.log(`✅ ${section}`);
  }
  
  // ملف ترحيبي
  root.createFile('00-مرحبا-بك.md', 
    '# 📁 Dot4Life — فريق\n\n'
    + 'هذا هو المخزن المركزي للملفات.\n\n'
    + '## القواعد:\n'
    + '- كل عضو يرفع في مجلده فقط\n'
    + '- الملفات الجاهزة → 🤖 لينو يسحب ويبني الصفحات\n'
    + '- لا تحذف ملفات الآخرين\n'
  );
  
  console.log('🎉 تم إنشاء كل الفولدرات بنجاح!');
  console.log('📁 المجلد الرئيسي: 📁 Dot4Life — فريق');
  console.log('📍 افتح Drive وهتلاقي المجلد الرئيسي جاهز');

  // رسالة تأكيد في الواجهة
  const ui = SpreadsheetApp.getUi();
  ui.alert('🎉 تم إنشاء كل الفولدرات! افتح Drive وهتشوف المجلد: 📁 Dot4Life — فريق');
}
