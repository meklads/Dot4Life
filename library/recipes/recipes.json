    {
      "slug": "iron-oats-breakfast",
      "category": "pregnancy",
      "title": { "en": "Iron-Rich Oats Breakfast", "ar": "فطور شوفان غني بالحديد" },
      "desc": {
        "en": "Warm oats with dates and nuts for steady morning energy.",
        "ar": "شوفان دافئ مع التمر والمكسرات لطاقة صباحية مستقرة."
      },
      "intro": {
        "en": "A gentle breakfast that pairs slow carbs with iron-friendly toppings. Suitable for most pregnancies — adjust portions with your care team.",
        "ar": "فطور لطيف يجمع الكربوهيدرات البطيئة مع إضافات تدعم الحديد. مناسب لمعظم حالات الحمل — عدّلي الحصص مع فريق الرعاية."
      },
      "prepMinutes": 5,
      "cookMinutes": 10,
      "servings": 2,
      "difficulty": { "en": "Easy", "ar": "سهل" },
      "budget": "low",
      "benefit": { "en": "Iron & folate support", "ar": "دعم الحديد والفولات" },
      "tags": {
        "en": ["Pregnancy", "Breakfast", "Iron"],
        "ar": ["حمل", "فطور", "حديد"]
      },
      "ingredients": {
        "en": [
          "1 cup rolled oats",
          "2 cups low-fat milk or fortified plant milk",
          "4 pitted dates, chopped",
          "2 tbsp crushed walnuts",
          "1 tbsp chia seeds",
          "Pinch of cinnamon",
          "Honey to taste (optional)"
        ],
        "ar": [
          "كوب شوفان",
          "كوبان حليب قليل الدسم أو حليب نباتي مدعّم",
          "4 حبات تمر منزوعة النوى ومفرومة",
          "ملعقتان كبيرتان جوز مجروش",
          "ملعقة كبيرة بذور شيا",
          "رشة قرفة",
          "عسل حسب الرغبة (اختياري)"
        ]
      },
      "steps": {
        "en": [
          "Simmer milk in a pot over medium heat.",
          "Stir in oats and cook 8–10 minutes until creamy.",
          "Remove from heat; fold in dates, walnuts, and chia.",
          "Season with cinnamon and serve warm."
        ],
        "ar": [
          "اغلي الحليب في قدر على نار متوسطة.",
          "أضيفي الشوفان وحرّكي 8–10 دقائق حتى يثخن.",
          "ارفعي القدر عن النار وامزجي التمر والجوز والشيا.",
          "رشّي القرفة وقدّميها دافئة."
        ]
      },
      "tips": {
        "en": [
          "Swap walnuts for pumpkin seeds if you prefer.",
          "Pair with orange slices to support iron absorption.",
          "Not medical advice — consult your doctor for dietary limits."
        ],
        "ar": [
          "يمكن استبدال الجوز بلب القرع.",
          "قدّميها مع شرائح برتقال لدعم امتصاص الحديد.",
          "ليس نصيحة طبية — استشيري طبيبك لأي قيود غذائية."
        ]
      },
      "related": ["lentil-spinach-soup", "date-nut-smoothie", "baked-salmon-veg"],
      "relatedArticle": "/tools/pregnancy-calculator.html",
      "relatedArticleLabel": {
        "en": "Pregnancy Calculator",
        "ar": "حاسبة الحمل"
      }
    },
