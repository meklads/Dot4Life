<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 420" fill="none">
  <defs>
    <linearGradient id="md-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#054241"/>
      <stop offset="50%" stop-color="#0a6b66"/>
      <stop offset="100%" stop-color="#1e5c4a"/>
    </linearGradient>
    <linearGradient id="md-dome" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#3ecf9a"/>
      <stop offset="100%" stop-color="#1a7a5c"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="420" fill="url(#md-bg)"/>
  <circle cx="480" cy="200" r="150" fill="#6ABFB8" opacity=".15"/>
  <!-- Nabawi -->
  <rect x="320" y="250" width="280" height="80" rx="4" fill="#6ABFB8" opacity=".2" stroke="#6ABFB8" stroke-width="1.5" stroke-opacity=".35"/>
  <ellipse cx="460" cy="218" rx="58" ry="32" fill="url(#md-dome)" opacity=".82"/>
  <rect x="395" y="160" width="12" height="170" rx="2" fill="#6ABFB8" opacity=".5"/>
  <rect x="513" y="160" width="12" height="170" rx="2" fill="#6ABFB8" opacity=".5"/>
  <!-- Hotel -->
  <rect x="680" y="175" width="140" height="155" rx="6" fill="#6ABFB8" opacity=".22" stroke="#6ABFB8" stroke-width="1.5" stroke-opacity=".4"/>
  <rect x="695" y="195" width="22" height="16" rx="2" fill="#6ABFB8" opacity=".4"/>
  <rect x="725" y="195" width="22" height="16" rx="2" fill="#FD781C" opacity=".35"/>
  <rect x="755" y="195" width="22" height="16" rx="2" fill="#6ABFB8" opacity=".4"/>
  <rect x="785" y="195" width="22" height="16" rx="2" fill="#6ABFB8" opacity=".4"/>
  <rect x="695" y="222" width="22" height="16" rx="2" fill="#6ABFB8" opacity=".35"/>
  <rect x="725" y="222" width="22" height="16" rx="2" fill="#6ABFB8" opacity=".35"/>
  <rect x="755" y="222" width="22" height="16" rx="2" fill="#6ABFB8" opacity=".35"/>
  <rect x="785" y="222" width="22" height="16" rx="2" fill="#6ABFB8" opacity=".35"/>
  <!-- Walking path -->
  <path d="M600 310 Q640 290 680 310" stroke="#FD781C" stroke-width="2" stroke-dasharray="5 6" opacity=".55" fill="none"/>
  <circle cx="640" cy="300" r="6" fill="#FD781C" opacity=".6"/>
  <g fill="#fff" opacity=".45"><circle cx="90" cy="50" r="1.2"/><circle cx="1110" cy="60" r="1"/></g>
