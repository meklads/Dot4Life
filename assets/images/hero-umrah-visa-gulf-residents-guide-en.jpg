<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 420" fill="none">
  <defs>
    <linearGradient id="uv-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#054241"/>
      <stop offset="50%" stop-color="#0a6b66"/>
      <stop offset="100%" stop-color="#1e4a44"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="420" fill="url(#uv-bg)"/>
  <circle cx="600" cy="210" r="165" fill="#6ABFB8" opacity=".13"/>
  <!-- Passport -->
  <rect x="420" y="145" width="130" height="170" rx="10" fill="#054241" stroke="#6ABFB8" stroke-width="2.5" opacity=".85"/>
  <circle cx="485" cy="210" r="32" fill="none" stroke="#FD781C" stroke-width="2" opacity=".7"/>
  <rect x="445" y="265" width="80" height="6" rx="3" fill="#6ABFB8" opacity=".45"/>
  <rect x="455" y="280" width="60" height="5" rx="2" fill="#6ABFB8" opacity=".3"/>
  <!-- Visa stamp -->
  <circle cx="580" cy="250" r="38" fill="none" stroke="#FD781C" stroke-width="3" stroke-dasharray="4 3" opacity=".75"/>
  <text x="580" y="256" text-anchor="middle" fill="#FD781C" font-size="11" font-family="Inter,sans-serif" font-weight="700" opacity=".9">VISA</text>
  <!-- Plane -->
  <path d="M720 180 L820 150 L780 195 L850 210 L780 225 L820 270 L720 240 L750 210 Z" fill="#6ABFB8" opacity=".55"/>
  <path d="M680 210 Q900 170 980 210" stroke="#fff" stroke-width="1.5" stroke-dasharray="6 8" opacity=".25" fill="none"/>
  <!-- Gulf map dots -->
  <g fill="#FD781C" opacity=".65">
    <circle cx="900" cy="120" r="4"/><circle cx="940" cy="140" r="3"/><circle cx="870" cy="155" r="3"/>
    <circle cx="920" cy="170" r="3.5"/><circle cx="960" cy="130" r="3"/>
  </g>
  <g fill="#fff" opacity=".4"><circle cx="100" cy="55" r="1.2"/><circle cx="1100" cy="65" r="1"/></g>
</svg>
